<view class="container">
  <view class="journal-top-bar">
    <text class="page-heading">觉察日记</text>
    <view class="insights-btn" bindtap="onOpenInsights">
      <text class="insights-btn-text">✨ 情绪洞察</text>
    </view>
  </view>

  <!-- Check-in List -->
  <view wx:if="{{checkIns.length > 0}}">
    <view
      class="check-in-card"
      wx:for="{{checkIns}}"
      wx:key="_id"
      data-id="{{item._id}}"
      bindtap="onCheckInTap"
      bindlongpress="onDeleteCheckIn"
    >
      <!-- Header: date + intensity -->
      <view class="checkin-header">
        <text class="text-muted checkin-date">{{item.dateFormatted}}</text>
        <view class="intensity-badge" wx:if="{{item.intensity}}" style="background-color: {{item.intensityColor}}20;">
          <text class="intensity-number" style="color: {{item.intensityColor}};">{{item.intensity}}</text>
          <text class="intensity-label" style="color: {{item.intensityColor}};">{{item.intensityLabel}}</text>
        </view>
      </view>

      <!-- Emotion chips (per-category color) -->
      <view class="chip-wrap checkin-emotions" wx:if="{{item.emotions.length > 0}}">
        <view
          class="chip chip-selected chip-small"
          wx:for="{{item.emotions}}"
          wx:for-item="em"
          wx:key="label"
          style="background-color: {{em.categoryColor}}20; color: {{em.categoryColor}};"
        >{{em.emoji}} {{em.label}}</view>
      </view>

      <!-- Body parts + sensations (grouped) -->
      <view wx:if="{{item.bodyGroups.length > 0}}" class="checkin-body-groups">
        <view class="body-group-row" wx:for="{{item.bodyGroups}}" wx:for-item="bg" wx:key="part">
          <text class="body-part-name">{{bg.part}}</text>
          <text class="body-sensations-text" wx:if="{{bg.sensationsText}}">{{bg.sensationsText}}</text>
        </view>
      </view>

      <!-- Trigger -->
      <view class="checkin-trigger" wx:if="{{item.trigger}}">
        <text class="trigger-text">{{item.trigger}}</text>
      </view>

      <!-- AI feedback preview -->
      <view class="checkin-feedback" wx:if="{{item.feedbackPreview}}">
        <text class="feedback-preview text-serif text-muted">{{item.feedbackPreview}}</text>
      </view>
    </view>
  </view>

  <!-- Empty State -->
  <view class="empty-state" wx:elif="{{!loading}}">
    <text class="empty-state-icon">🌱</text>
    <text class="empty-state-text">还没有觉察记录</text>
    <view class="empty-cta" bindtap="onStartCheckIn">
      <text class="text-accent">开始你的第一次觉察</text>
    </view>
  </view>

  <!-- Loading -->
  <view class="loading-footer" wx:if="{{loading}}">
    <view class="loading-dots">
      <view class="dot"></view>
      <view class="dot"></view>
      <view class="dot"></view>
    </view>
  </view>

  <!-- No More -->
  <view class="no-more-footer" wx:if="{{!hasMore && checkIns.length > 0}}">
    <text class="text-muted">没有更多了</text>
  </view>
</view>
