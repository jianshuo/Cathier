/* Journal — check-in list page-specific overrides */

.journal-top-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: var(--space-sm);
}

.insights-btn {
  display: inline-flex;
  align-items: center;
  padding: 10rpx 24rpx;
  border-radius: var(--radius-full);
  background-color: var(--accent-light);
  border: 2rpx solid var(--accent);
}

.insights-btn-text {
  font-size: 24rpx;
  color: var(--accent);
  font-weight: 500;
}

.checkin-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.checkin-date {
  font-size: 24rpx;
}

.intensity-badge {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  min-width: 48rpx;
  height: 48rpx;
  padding: 0 16rpx;
  border-radius: var(--radius-full, 999rpx);
  font-size: 24rpx;
  font-weight: 600;
}

.intensity-number {
  font-size: 24rpx;
  font-weight: 600;
}

.intensity-label {
  font-size: 20rpx;
  font-weight: 500;
}

.checkin-emotions {
  margin-bottom: 12rpx;
}

.chip-small {
  padding: 8rpx 20rpx;
  font-size: 24rpx;
}

/* --- Body Parts (grouped) --- */

.checkin-body-groups {
  margin-bottom: 12rpx;
}

.body-group-row {
  display: flex;
  align-items: baseline;
  gap: 8rpx;
  margin-bottom: 4rpx;
  line-height: 1.6;
}

.body-part-name {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--accent);
  flex-shrink: 0;
}

.body-sensations-text {
  font-size: 24rpx;
  color: var(--text-secondary);
}

.checkin-trigger {
  margin-top: 12rpx;
  padding-top: 12rpx;
  border-top: 1rpx solid var(--border);
}

.trigger-text {
  font-size: 26rpx;
  color: var(--text-primary);
  line-height: 1.6;
}

.checkin-feedback {
  margin-top: 12rpx;
}

.feedback-preview {
  font-size: 26rpx;
  line-height: 1.8;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.empty-cta {
  margin-top: 24rpx;
  padding: 16rpx 40rpx;
  border: 2rpx solid var(--accent);
  border-radius: var(--radius-full);
}

.loading-footer {
  padding: 32rpx;
}

.no-more-footer {
  text-align: center;
  padding: 32rpx;
  font-size: 24rpx;
}
