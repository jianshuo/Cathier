/* Journal — check-in list page-specific overrides */

.checkin-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.checkin-date {
  font-size: 24rpx;
}

.intensity-badge {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background-color: var(--accent-light);
  color: var(--accent);
  font-size: 24rpx;
  font-weight: 600;
}

.checkin-emotions {
  margin-bottom: 12rpx;
}

.chip-small {
  padding: 8rpx 20rpx;
  font-size: 24rpx;
}

.body-parts-text {
  font-size: 24rpx;
  margin-bottom: 8rpx;
}

.checkin-trigger {
  margin-top: 12rpx;
  padding-top: 12rpx;
  border-top: 1rpx solid var(--border);
}

.trigger-text {
  font-size: 26rpx;
  color: var(--text-primary);
  line-height: 1.6;
}

.checkin-feedback {
  margin-top: 12rpx;
}

.feedback-preview {
  font-size: 26rpx;
  line-height: 1.8;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.empty-cta {
  margin-top: 24rpx;
  padding: 16rpx 40rpx;
  border: 2rpx solid var(--accent);
  border-radius: var(--radius-full);
}

.loading-footer {
  padding: 32rpx;
}

.no-more-footer {
  text-align: center;
  padding: 32rpx;
  font-size: 24rpx;
}
