<view class="container">
  <!-- Step Indicator: 3 segments, all active -->
  <view class="step-indicator">
    <view class="step-segment step-segment-active"></view>
    <view class="step-segment step-segment-active"></view>
    <view class="step-segment step-segment-active"></view>
  </view>

  <text class="page-heading">觉察反馈</text>

  <!-- Summary Card -->
  <view class="card summary-card" wx:if="{{checkInData}}">
    <text class="section-label">本次觉察</text>

    <!-- Body sensations structured display -->
    <block wx:for="{{checkInData.bodySensationsList}}" wx:key="part">
      <view class="summary-row" wx:if="{{item.sensations.length > 0}}">
        <text class="summary-label">{{item.part}}</text>
        <view class="sensation-tags">
          <text class="sensation-tag">{{item.sensations}}</text>
        </view>
      </view>
      <view class="summary-row" wx:else>
        <text class="summary-label">{{item.part}}</text>
      </view>
    </block>

    <view class="summary-row" wx:if="{{checkInData.intensity}}">
      <text class="summary-label">强度</text>
      <view class="intensity-badge">{{checkInData.intensity}}/10</view>
    </view>

    <!-- Emotions -->
    <view class="summary-row summary-row-wrap" wx:if="{{checkInData.emotions.length > 0}}">
      <text class="summary-label">情绪</text>
      <view class="chip-wrap">
        <text
          wx:for="{{checkInData.emotions}}"
          wx:key="id"
          class="chip chip-selected"
        >{{item.emoji}} {{item.name}}</text>
      </view>
    </view>

    <view class="summary-row" wx:if="{{checkInData.trigger}}">
      <text class="summary-label">触发</text>
      <text class="summary-value">{{checkInData.trigger}}</text>
    </view>

    <view class="summary-row" wx:if="{{checkInData.note}}">
      <text class="summary-label">备注</text>
      <text class="summary-value">{{checkInData.note}}</text>
    </view>
  </view>

  <!-- AI Feedback Card -->
  <view class="ai-card" wx:if="{{loading}}">
    <view class="ai-card-header">
      <view class="ai-dot"></view>
      <text>AI 觉察反馈</text>
    </view>
    <view class="ai-card-body">
      <view class="loading-dots">
        <view class="dot"></view>
        <view class="dot"></view>
        <view class="dot"></view>
      </view>
      <text class="loading-hint text-muted">AI正在感知中...</text>
    </view>
  </view>

  <view class="ai-card" wx:elif="{{error}}">
    <view class="ai-card-header">
      <view class="ai-dot ai-dot-error"></view>
      <text>AI 觉察反馈</text>
    </view>
    <view class="ai-card-body ai-error-body">
      <text class="error-text">{{errorMessage || '生成反馈时出现了问题'}}</text>
      <view class="btn-secondary retry-btn" bindtap="onRetry">重试</view>
    </view>
  </view>

  <view class="ai-card" wx:else>
    <view class="ai-card-header">
      <view class="ai-dot"></view>
      <text>AI 觉察反馈</text>
    </view>
    <view class="ai-card-body">
      <text class="text-serif">{{feedback}}</text>
    </view>
  </view>

  <!-- Micro-exercise Button (shown after AI feedback loads) -->
  <view class="exercise-entry" wx:if="{{feedback && !loading && !error}}" bindtap="onOpenExercise">
    <text class="exercise-entry-icon">🧘</text>
    <text class="exercise-entry-text">试试觉察练习</text>
    <text class="exercise-entry-arrow">›</text>
  </view>

  <!-- Privacy Tier Picker (only if user has a friend profile) -->
  <view class="card tier-card" wx:if="{{hasProfile}}">
    <text class="section-label">分享给好友</text>
    <view class="tier-options">
      <view class="tier-option {{selectedTier === null ? 'tier-selected' : ''}}" bindtap="onSelectTier" data-tier="">
        <text class="tier-icon">🔒</text>
        <text class="tier-label">不分享</text>
      </view>
      <view class="tier-option {{selectedTier === 'category' ? 'tier-selected' : ''}}" bindtap="onSelectTier" data-tier="category">
        <text class="tier-icon">📂</text>
        <text class="tier-label">仅类别</text>
      </view>
      <view class="tier-option {{selectedTier === 'emotions' ? 'tier-selected' : ''}}" bindtap="onSelectTier" data-tier="emotions">
        <text class="tier-icon">💬</text>
        <text class="tier-label">情绪</text>
      </view>
      <view class="tier-option {{selectedTier === 'full' ? 'tier-selected' : ''}}" bindtap="onSelectTier" data-tier="full">
        <text class="tier-icon">📖</text>
        <text class="tier-label">完整</text>
      </view>
    </view>
  </view>

  <!-- Action Buttons (always visible) -->
  <view class="action-buttons">
    <view class="btn-primary {{saved ? 'btn-saved' : ''}}" bindtap="onSave">
      {{saved ? '已保存 ✓' : '保存觉察'}}
    </view>
  </view>

  <view class="disclaimer">本小程序不提供医疗建议，AI反馈仅供参考</view>
</view>

<!-- Micro-exercise Bottom Sheet Overlay -->
<view class="overlay {{showExercise ? 'overlay-visible' : ''}}" bindtap="onCloseExercise">
  <view class="exercise-sheet {{showExercise ? 'exercise-sheet-visible' : ''}}" catchtap="">
    <view class="exercise-sheet-handle"></view>
    <view class="exercise-header">
      <text class="exercise-title">{{exerciseData.title}}</text>
      <view class="exercise-close" bindtap="onCloseExercise">✕</view>
    </view>
    <view class="exercise-steps">
      <view class="exercise-step" wx:for="{{exerciseData.steps}}" wx:key="index">
        <view class="exercise-step-num">{{index + 1}}</view>
        <text class="exercise-step-text">{{item}}</text>
      </view>
    </view>
    <view class="exercise-footer">
      <text class="exercise-hint">完成后，留意身体有什么变化</text>
    </view>
  </view>
</view>
