.lesson-page {
  padding-bottom: 0;
  display: flex;
  flex-direction: column;
  height: 100vh;
  box-sizing: border-box;
  padding-top: 0;
}

/* =========================== INTRO =========================== */

.intro-view {
  flex: 1;
  display: flex;
  flex-direction: column;
  padding: 60rpx var(--space-lg) var(--space-xl);
}

.intro-header {
  margin-bottom: var(--space-xl);
}

.intro-title-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: var(--space-sm);
}

.intro-title-icon {
  font-size: 40rpx;
}

.intro-title {
  font-size: 44rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.intro-subtitle {
  display: block;
  font-size: 28rpx;
  color: var(--text-secondary);
  line-height: 1.6;
}

.intro-form {
  margin-bottom: var(--space-xl);
}

.intro-label {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: var(--space-sm);
}

.intro-input {
  width: 100%;
  box-sizing: border-box;
  background-color: var(--surface);
  border: 1rpx solid var(--border);
  border-radius: var(--radius-medium);
  padding: 24rpx;
  font-size: 30rpx;
  color: var(--text-primary);
  line-height: 1.6;
  min-height: 120rpx;
}

.intro-placeholder {
  color: var(--text-muted);
  font-size: 30rpx;
}

.intro-error {
  display: block;
  font-size: 24rpx;
  color: var(--accent);
  margin-top: 12rpx;
}

.intro-continue {
  margin-top: var(--space-md);
}

.btn-disabled {
  opacity: 0.4;
}

/* =========================== CHAT =========================== */

.chat-view {
  flex: 1;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.msg-list {
  flex: 1;
  overflow-y: auto;
}

.msg-spacer {
  height: var(--space-md);
}

.msg-bottom-pad {
  height: 40rpx;
}

.msg-row {
  display: flex;
  padding: 12rpx var(--space-lg);
}

.msg-row-user {
  justify-content: flex-end;
}

.msg-row-ai {
  justify-content: flex-start;
}

.msg-bubble {
  max-width: 75%;
  padding: 24rpx 28rpx;
  border-radius: 24rpx;
  line-height: 1.6;
}

.bubble-ai {
  background-color: var(--surface);
  border-radius: 8rpx 24rpx 24rpx 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(26, 22, 19, 0.06);
}

.bubble-user {
  background-color: var(--accent);
  border-radius: 24rpx 8rpx 24rpx 24rpx;
}

.msg-text {
  font-size: 30rpx;
  line-height: 1.65;
}

.bubble-ai .msg-text {
  color: var(--text-primary);
}

.bubble-user .msg-text {
  color: #FFFFFF;
}

.bubble-loading {
  padding: 20rpx 28rpx;
  min-width: 80rpx;
}

/* --- Option chips --- */

.options-row {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  padding: 4rpx var(--space-lg) 12rpx;
}

.option-chip {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 14rpx 22rpx;
  background-color: var(--bg);
  border: 1rpx solid var(--border);
  border-radius: var(--radius-full);
  max-width: 100%;
  transition: background-color 0.15s ease, border-color 0.15s ease;
}

.option-chip-disabled {
  opacity: 0.5;
}

.option-chip-num {
  font-size: 26rpx;
  color: var(--text-muted);
  flex-shrink: 0;
}

.option-chip-text {
  font-size: 28rpx;
  color: var(--text-primary);
  line-height: 1.5;
  word-break: break-word;
}

/* --- Input area --- */

.input-area {
  flex-shrink: 0;
  padding: var(--space-sm) var(--space-lg) var(--space-xl);
  background-color: var(--bg);
  border-top: 1rpx solid var(--border);
}

.input-row {
  display: flex;
  align-items: flex-end;
  gap: var(--space-sm);
  background-color: var(--surface);
  border-radius: var(--radius-medium);
  padding: 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(26, 22, 19, 0.06);
}

.msg-input {
  flex: 1;
  font-size: 30rpx;
  color: var(--text-primary);
  background: transparent;
  line-height: 1.6;
  min-height: 56rpx;
  max-height: 200rpx;
}

.input-placeholder {
  color: var(--text-muted);
  font-size: 30rpx;
}

.send-btn {
  width: 72rpx;
  height: 72rpx;
  border-radius: var(--radius-full);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  transition: background-color 0.15s ease;
}

.send-btn-active {
  background-color: var(--accent);
}

.send-btn-disabled {
  background-color: var(--border);
}

.send-icon {
  font-size: 32rpx;
  font-weight: 700;
  color: #FFFFFF;
  line-height: 1;
}

/* =========================== SUMMARY =========================== */

.summary-view {
  flex: 1;
  padding: 60rpx var(--space-lg) var(--space-3xl);
  overflow-y: auto;
}

.summary-header {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: var(--space-lg);
}

.summary-title-icon {
  font-size: 36rpx;
}

.summary-title-text {
  font-size: 36rpx;
  font-weight: 600;
  color: var(--accent);
}

.summary-card {
  background-color: var(--accent-light);
  border: 1rpx solid rgba(242, 112, 10, 0.2);
  border-radius: var(--radius-medium);
  padding: var(--space-lg);
  margin-bottom: var(--space-xl);
}

.summary-loading {
  display: flex;
  align-items: center;
  gap: var(--space-sm);
  padding: var(--space-md) 0;
}

.summary-loading-text {
  font-size: 28rpx;
  color: var(--text-secondary);
}

.summary-error {
  display: flex;
  align-items: center;
  gap: var(--space-md);
  padding: var(--space-md) 0;
}

.summary-error-text {
  font-size: 28rpx;
  color: var(--text-secondary);
}

.summary-retry {
  font-size: 28rpx;
  color: var(--accent);
  font-weight: 500;
}

.summary-empty {
  padding: var(--space-md) 0;
}

.card-row {
  margin-bottom: var(--space-md);
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.card-row:last-child {
  margin-bottom: 0;
}

.card-label {
  display: block;
  font-size: 26rpx;
  font-weight: 600;
  color: var(--accent);
  letter-spacing: 0.5rpx;
}

.card-content {
  display: block;
  font-size: 30rpx;
  color: var(--text-primary);
  line-height: 1.65;
}

.save-btn {
  margin-top: var(--space-md);
}

.saved-hint {
  text-align: center;
  padding: var(--space-md);
}

/* Override .loading-dots padding inside small containers (chat bubble, summary card) */
.bubble-loading .loading-dots,
.summary-loading .loading-dots {
  padding: 0;
  gap: 8rpx;
}

.bubble-loading .loading-dots .dot,
.summary-loading .loading-dots .dot {
  width: 12rpx;
  height: 12rpx;
  background-color: var(--text-muted);
}
