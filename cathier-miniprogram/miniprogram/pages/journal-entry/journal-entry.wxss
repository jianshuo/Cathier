/* Journal Entry page */

.journal-entry-page {
  padding-top: var(--space-xl);
}

.section {
  margin-bottom: var(--space-lg);
}

/* --- Mood Selector --- */

.mood-row {
  display: flex;
  justify-content: space-between;
  gap: 12rpx;
  margin-top: var(--space-sm);
}

.mood-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 120rpx;
  height: 140rpx;
  border-radius: var(--radius-medium);
  background-color: var(--surface);
  border: 2rpx solid var(--border);
  transition: all 0.2s ease;
}

.mood-item:active {
  transform: scale(0.95);
}

.mood-selected {
  border-color: var(--accent);
  background-color: var(--accent-light);
  box-shadow: 0 4rpx 16rpx rgba(242, 112, 10, 0.2);
}

.mood-emoji {
  font-size: 48rpx;
  line-height: 1.2;
  margin-bottom: 8rpx;
}

.mood-label {
  font-size: 22rpx;
  color: var(--text-muted);
}

.mood-selected .mood-label {
  color: var(--accent);
  font-weight: 500;
}

/* --- Gains Textarea --- */

.warm-textarea {
  width: 100%;
  min-height: 120rpx;
  padding: 20rpx;
  font-size: 28rpx;
  color: var(--text-primary);
  background-color: var(--bg);
  border-radius: var(--radius-small);
  border: 2rpx solid var(--border);
  box-sizing: border-box;
  margin-top: 12rpx;
  line-height: 1.6;
}

.warm-textarea:focus {
  border-color: var(--accent);
}

.gains-textarea {
  min-height: 240rpx;
}

/* --- Save Button --- */

.save-btn {
  margin-top: var(--space-xl);
  margin-bottom: var(--space-lg);
}
