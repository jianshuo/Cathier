<wxs src="../../utils/array-helper.wxs" module="arr" />

<view class="container">
  <!-- Step Indicator: 3 segments, second active -->
  <view class="step-indicator">
    <view class="step-segment step-segment-active"></view>
    <view class="step-segment step-segment-active"></view>
    <view class="step-segment"></view>
  </view>

  <text class="page-heading">情绪命名</text>
  <text class="page-subheading">你感受到了什么情绪？</text>

  <!-- Emotion Categories -->
  <view class="card">
    <text class="section-title">情绪类别</text>
    <view class="chip-wrap">
      <view
        wx:for="{{categories}}"
        wx:key="id"
        class="{{item.valence === 'positive' ? 'chip chip-sage' : 'chip'}} {{selectedCategoryId === item.id ? (item.valence === 'positive' ? 'chip-sage-selected' : 'chip-selected') : ''}}"
        data-id="{{item.id}}"
        bindtap="onSelectCategory"
      >
        {{item.name}}
      </view>
    </view>
  </view>

  <!-- Specific Emotions for selected category -->
  <view class="card" wx:if="{{specificEmotions.length > 0}}">
    <text class="section-title">{{selectedCategoryName}} 的具体情绪</text>
    <text class="section-subtitle">可以跨类别选择多个情绪</text>
    <view class="chip-wrap">
      <view
        wx:for="{{specificEmotions}}"
        wx:key="id"
        class="chip {{arr.includes(selectedEmotionIds, item.id) ? 'chip-selected' : ''}}"
        data-id="{{item.id}}"
        data-name="{{item.name}}"
        data-emoji="{{item.emoji}}"
        bindtap="onToggleEmotion"
        bindlongpress="onEmotionLongPress"
      >
        <text class="emotion-emoji">{{item.emoji}}</text>
        <text>{{item.name}}</text>
      </view>
    </view>
  </view>

  <!-- Selected emotions summary -->
  <view class="card selected-emotions-card" wx:if="{{selectedEmotions.length > 0}}">
    <text class="section-title">已选情绪</text>
    <view class="chip-wrap">
      <view
        wx:for="{{selectedEmotions}}"
        wx:key="id"
        class="chip chip-selected"
        data-id="{{item.id}}"
        data-name="{{item.name}}"
        data-emoji="{{item.emoji}}"
        bindtap="onToggleEmotion"
      >
        {{item.emoji}} {{item.name}}
      </view>
    </view>
  </view>

  <!-- Trigger Input -->
  <view class="card">
    <text class="section-title">触发事件</text>
    <textarea
      class="warm-textarea"
      placeholder="是什么触发了这些感觉？（可选）"
      value="{{trigger}}"
      bindinput="onTriggerInput"
      maxlength="200"
      auto-height
    />
  </view>

  <!-- Note Input -->
  <view class="card">
    <text class="section-title">备注</text>
    <textarea
      class="warm-textarea"
      placeholder="想记录些什么？（可选）"
      value="{{note}}"
      bindinput="onNoteInput"
      maxlength="500"
      auto-height
    />
  </view>

  <!-- Next Button -->
  <view class="btn-primary next-btn" bindtap="onNext">
    下一步：AI 反馈
  </view>
</view>

<!-- Emotion Detail Bottom Sheet -->
<view class="popover-overlay {{showPopover ? 'popover-overlay-visible' : ''}}" bindtap="onClosePopover">
  <view class="popover-sheet {{showPopover ? 'popover-sheet-visible' : ''}}" catchtap="">
    <view class="popover-handle"></view>

    <!-- Emoji + Name -->
    <view class="popover-hero" wx:if="{{popoverEmotion}}">
      <text class="popover-emoji">{{popoverEmotion.emoji}}</text>
      <text class="popover-name">{{popoverEmotion.name}}</text>
    </view>

    <!-- Intensity Bars -->
    <view class="popover-intensity" wx:if="{{popoverEmotion}}">
      <text class="popover-section-label">强度</text>
      <view class="intensity-bars">
        <view class="intensity-bar {{popoverEmotion.intensity >= 1 ? 'intensity-bar-active' : ''}}"></view>
        <view class="intensity-bar {{popoverEmotion.intensity >= 2 ? 'intensity-bar-active' : ''}}"></view>
        <view class="intensity-bar {{popoverEmotion.intensity >= 3 ? 'intensity-bar-active' : ''}}"></view>
        <view class="intensity-bar {{popoverEmotion.intensity >= 4 ? 'intensity-bar-active' : ''}}"></view>
        <view class="intensity-bar {{popoverEmotion.intensity >= 5 ? 'intensity-bar-active' : ''}}"></view>
      </view>
    </view>

    <!-- Definition -->
    <view class="popover-definition" wx:if="{{popoverEmotion.definition}}">
      <text class="popover-section-label">释义</text>
      <text class="popover-definition-text">{{popoverEmotion.definition}}</text>
    </view>

    <!-- Similar Emotions -->
    <view class="popover-similar" wx:if="{{popoverDiffers.length > 0}}">
      <text class="popover-section-label">相似情绪</text>
      <view class="popover-similar-list">
        <view class="popover-similar-item" wx:for="{{popoverDiffers}}" wx:key="name">
          <text class="popover-similar-name">{{item.name}}</text>
          <text class="popover-similar-diff">{{item.diff}}</text>
        </view>
      </view>
    </view>

    <!-- Dictionary Link -->
    <view class="popover-link" bindtap="onGoToDictionary" wx:if="{{popoverEmotion}}">
      <text class="popover-link-text">在词典中查看</text>
      <text class="popover-link-arrow">›</text>
    </view>
  </view>
</view>
