<view class="container">
  <text class="page-heading">邀请好友</text>
  <text class="page-subheading">发送邀请给微信好友，一起觉察身体感受</text>

  <!-- Invite Card -->
  <view class="card invite-card">
    <view wx:if="{{codeLoading}}" class="loading-dots" style="padding: 48rpx 0;">
      <view class="dot"></view>
      <view class="dot"></view>
      <view class="dot"></view>
    </view>

    <view wx:elif="{{inviteCode}}" class="invite-ready">
      <text class="invite-label text-muted">你的邀请已准备好</text>
      <text class="invite-hint text-muted">邀请码 24 小时内有效</text>

      <button class="btn-primary invite-btn" open-type="share">
        发送给好友
      </button>

      <!-- Fallback: manual copy for edge cases -->
      <view class="manual-code-section">
        <text class="manual-hint text-muted">或者让好友手动输入邀请码：</text>
        <view class="manual-code-row" bindtap="onCopyCode">
          <text class="manual-code">{{inviteCode}}</text>
          <text class="manual-copy text-accent">复制</text>
        </view>
      </view>
    </view>

    <view wx:else class="invite-error">
      <text class="text-muted">生成邀请码失败</text>
      <button class="btn-secondary" bindtap="onGenerateCode">重试</button>
    </view>
  </view>

  <!-- Pending Invites -->
  <view class="card" wx:if="{{pendingCodes.length > 0}}">
    <text class="section-label">待使用的邀请</text>
    <view class="pending-list">
      <view class="pending-item" wx:for="{{pendingCodes}}" wx:key="code">
        <text class="pending-code">{{item.code}}</text>
        <text class="pending-expiry text-muted">{{item.expiryText}}</text>
      </view>
    </view>
  </view>
</view>
