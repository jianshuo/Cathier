/* Add Friend page styles */

.invite-card {
  padding: var(--space-lg);
}

.invite-ready {
  text-align: center;
}

.invite-label {
  display: block;
  font-size: 28rpx;
  margin-bottom: var(--space-xs);
}

.invite-hint {
  display: block;
  font-size: 24rpx;
  margin-bottom: var(--space-lg);
}

.invite-btn {
  margin-bottom: var(--space-xl);
}

/* Manual code fallback */
.manual-code-section {
  border-top: 2rpx solid var(--border);
  padding-top: var(--space-md);
}

.manual-hint {
  display: block;
  font-size: 22rpx;
  margin-bottom: var(--space-sm);
}

.manual-code-row {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: var(--space-sm);
  padding: var(--space-sm) 0;
}

.manual-code {
  font-size: 40rpx;
  font-weight: 700;
  letter-spacing: 12rpx;
  color: var(--text-primary);
  font-family: 'Menlo', 'Courier New', monospace;
}

.manual-copy {
  font-size: 24rpx;
  font-weight: 600;
}

/* Invite error */
.invite-error {
  text-align: center;
  padding: var(--space-lg) 0;
}

.invite-error .btn-secondary {
  margin-top: var(--space-md);
  width: auto;
  display: inline-flex;
  padding: 16rpx 48rpx;
}

/* Pending invites */
.pending-list {
  margin-top: var(--space-sm);
}

.pending-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: var(--space-sm) 0;
  border-bottom: 1rpx solid var(--border);
}

.pending-item:last-child {
  border-bottom: none;
}

.pending-code {
  font-size: 28rpx;
  font-weight: 600;
  letter-spacing: 4rpx;
  font-family: 'Menlo', 'Courier New', monospace;
  color: var(--text-secondary);
}

.pending-expiry {
  font-size: 22rpx;
}
