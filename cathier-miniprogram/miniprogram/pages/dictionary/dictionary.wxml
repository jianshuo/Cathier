<view class="container">
  <text class="page-heading">觉察词典</text>

  <!-- Search Bar -->
  <view class="search-bar">
    <input
      class="search-input"
      placeholder="搜索情绪、感觉..."
      value="{{searchQuery}}"
      bindinput="onSearchInput"
    />
  </view>

  <!-- Segmented Control Tabs -->
  <view class="segmented-control">
    <view
      wx:for="{{tabs}}"
      wx:key="*this"
      class="segment {{activeTab === index ? 'segment-active' : ''}}"
      data-index="{{index}}"
      bindtap="onTabChange"
    >
      {{item}}
    </view>
  </view>

  <!-- Tab 0: Emotions -->
  <view wx:if="{{activeTab === 0}}">
    <view
      class="card dict-card"
      wx:for="{{filteredCategories}}"
      wx:key="id"
    >
      <view class="dict-header" data-name="{{item.name}}" bindtap="onToggleCategory">
        <view class="dict-header-left">
          <view class="cat-color-dot" style="background-color: {{item.colorHex || 'var(--accent)'}}"></view>
          <text class="dict-name">{{item.name}}</text>
          <text class="dict-name-en text-muted">{{item.nameEn}}</text>
          <text class="valence-tag {{item.valence === 'positive' ? 'valence-positive' : item.valence === 'negative' ? 'valence-negative' : 'valence-neutral'}}">{{item.valence === 'positive' ? '正面' : item.valence === 'negative' ? '负面' : '中性'}}</text>
        </view>
        <view class="dict-header-right">
          <text class="text-muted dict-count">{{item.count}} 个</text>
          <text class="dict-arrow {{expandedCategory === item.name ? 'arrow-expanded' : ''}}">›</text>
        </view>
      </view>

      <!-- Expanded: show emotion chips, tap to open detail -->
      <view class="dict-items" wx:if="{{expandedCategory === item.name}}">
        <view class="chip-wrap">
          <view
            class="chip"
            wx:for="{{item.emotions}}"
            wx:for-item="em"
            wx:key="id"
            data-id="{{em.id}}"
            data-cat="{{item.name}}"
            bindtap="onShowEmotionDetail"
          >
            <text class="emotion-emoji">{{em.emoji}}</text>
            <text>{{em.name}}</text>
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- Tab 1: Body Sensations -->
  <view wx:if="{{activeTab === 1}}">
    <view
      class="card dict-card"
      wx:for="{{filteredBodyPartSensations}}"
      wx:key="name"
    >
      <view class="dict-header" data-name="{{item.name}}" bindtap="onToggleBodyPart">
        <view class="dict-header-left">
          <text class="dict-name">{{item.name}}</text>
        </view>
        <view class="dict-header-right">
          <text class="text-muted dict-count">{{item.sensations.length}} 种感觉</text>
          <text class="dict-arrow {{expandedBodyPart === item.name ? 'arrow-expanded' : ''}}">›</text>
        </view>
      </view>
      <view class="dict-items" wx:if="{{expandedBodyPart === item.name}}">
        <view class="chip-wrap">
          <view class="chip" wx:for="{{item.sensations}}" wx:for-item="s" wx:key="*this"
            data-name="{{s}}" data-part="{{item.name}}" bindtap="onShowSensationDetail">
            {{s}}
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- Tab 2: Body Parts -->
  <view wx:if="{{activeTab === 2}}">
    <view
      class="card dict-card dict-card-simple"
      wx:for="{{filteredBodyPartList}}"
      wx:key="name"
      data-name="{{item.name}}"
      bindtap="onShowBodyPartDetail"
    >
      <text class="dict-name">{{item.name}}</text>
      <text class="dict-arrow">›</text>
    </view>
  </view>

  <!-- Empty Search States -->
  <view class="empty-state" wx:if="{{activeTab === 0 && filteredCategories.length === 0}}">
    <text class="empty-state-text">没有找到匹配的情绪词汇</text>
  </view>
  <view class="empty-state" wx:if="{{activeTab === 1 && filteredBodyPartSensations.length === 0}}">
    <text class="empty-state-text">没有找到匹配的身体感觉</text>
  </view>
  <view class="empty-state" wx:if="{{activeTab === 2 && filteredBodyPartList.length === 0}}">
    <text class="empty-state-text">没有找到匹配的身体部位</text>
  </view>

  <!-- Detail Popup Overlay -->
  <view class="popup-mask" wx:if="{{detailVisible}}" bindtap="onCloseDetail"></view>
  <view class="popup-sheet {{detailVisible ? 'popup-sheet-show' : ''}}" wx:if="{{detailVisible}}">
    <view class="popup-handle" bindtap="onCloseDetail">
      <view class="popup-handle-bar"></view>
    </view>

    <!-- Emotion Detail -->
    <view wx:if="{{detailType === 'emotion'}}" class="popup-content">
      <!-- Hero Header: centered emoji + name + English + intensity bars -->
      <view class="hero-header">
        <text class="hero-emoji">{{detailData.emoji}}</text>
        <text class="hero-name">{{detailData.name}}</text>
        <text class="hero-name-en text-muted">{{detailData.nameEn}}</text>
        <view class="intensity-bars-row">
          <view wx:for="{{detailData.intensityDots}}" wx:key="index"
            class="intensity-bar {{item.filled ? 'intensity-bar-filled' : ''}}"
            style="{{item.filled ? 'background-color:' + detailData.categoryColor : ''}}"></view>
        </view>
        <text class="popup-category-tag {{detailData.categoryValence === 'positive' ? 'valence-positive' : detailData.categoryValence === 'negative' ? 'valence-negative' : 'valence-neutral'}}" style="{{detailData.categoryColor ? 'background-color:' + detailData.categoryColor + '10; color:' + detailData.categoryColor : ''}}">{{detailData.categoryName}}</text>
      </view>

      <!-- Definition -->
      <view class="popup-section">
        <view class="popup-label-row">
          <text class="popup-label">释义</text>
        </view>
        <text class="popup-definition popup-body-serif">{{detailData.definition}}</text>
      </view>

      <!-- Similar emotions -->
      <view class="popup-section" wx:if="{{detailData.similarTo.length > 0}}">
        <view class="popup-label-row">
          <text class="popup-label">相似情绪</text>
        </view>
        <view class="chip-wrap">
          <view class="chip chip-small chip-category" wx:for="{{detailData.similarTo}}" wx:key="*this"
            style="{{detailData.categoryColor ? 'background-color:' + detailData.categoryColor + '12; color:' + detailData.categoryColor + '; border-color:' + detailData.categoryColor + '30' : ''}}">{{item}}</view>
        </view>
      </view>

      <!-- Differences -->
      <view class="popup-section" wx:if="{{detailData.differsList.length > 0}}">
        <view class="popup-label-row">
          <text class="popup-label">与相似情绪的区别</text>
        </view>
        <view class="popup-differs" wx:for="{{detailData.differsList}}" wx:key="key">
          <text class="popup-differs-key">vs {{item.key}}</text>
          <text class="popup-differs-value popup-body-serif">{{item.value}}</text>
        </view>
      </view>

      <view class="popup-section-divider" wx:if="{{detailData.origin}}"></view>

      <view class="popup-section" wx:if="{{detailData.origin}}">
        <view class="popup-label-row">
          <text class="popup-label">源起</text>
        </view>
        <text class="popup-body-text popup-body-serif">{{detailData.origin}}</text>
      </view>

      <view class="popup-section" wx:if="{{detailData.experience}}">
        <view class="popup-label-row">
          <text class="popup-label">体验</text>
        </view>
        <text class="popup-body-text popup-body-serif">{{detailData.experience}}</text>
      </view>

      <view class="popup-section" wx:if="{{detailData.embodiment}}">
        <view class="popup-label-row">
          <text class="popup-label">具身</text>
        </view>
        <text class="popup-body-text popup-body-serif">{{detailData.embodiment}}</text>
      </view>

      <view class="popup-section" wx:if="{{detailData.imagery}}">
        <view class="popup-label-row">
          <text class="popup-label">意象</text>
        </view>
        <text class="popup-body-text popup-body-serif">{{detailData.imagery}}</text>
      </view>

      <view class="popup-section" wx:if="{{detailData.developmentalStage}}">
        <view class="popup-label-row">
          <text class="popup-label">发展阶段</text>
        </view>
        <text class="popup-body-text popup-body-serif">{{detailData.developmentalStage}}</text>
      </view>

      <view class="popup-section" wx:if="{{detailData.formativeEvents}}">
        <view class="popup-label-row">
          <text class="popup-label">塑造事件</text>
        </view>
        <text class="popup-body-text popup-body-serif">{{detailData.formativeEvents}}</text>
      </view>

      <view class="popup-section" wx:if="{{detailData.personalityImpact}}">
        <view class="popup-label-row">
          <text class="popup-label">性格影响</text>
        </view>
        <text class="popup-body-text popup-body-serif">{{detailData.personalityImpact}}</text>
      </view>

      <view class="popup-section" wx:if="{{detailData.transformation}}">
        <view class="popup-label-row">
          <text class="popup-label">转化</text>
        </view>
        <text class="popup-body-text popup-body-serif">{{detailData.transformation}}</text>
      </view>

      <view class="popup-section" wx:if="{{detailData.literaryReference}}">
        <view class="popup-label-row">
          <text class="popup-label">文学引用</text>
        </view>
        <view class="popup-quote">
          <text class="popup-body-text popup-body-serif">{{detailData.literaryReference}}</text>
        </view>
      </view>
    </view>

    <!-- Sensation Detail -->
    <view wx:if="{{detailType === 'sensation'}}" class="popup-content">
      <view class="hero-header">
        <text class="hero-name">{{detailData.name}}</text>
        <text class="hero-name-en text-muted">身体感觉</text>
      </view>

      <view class="popup-section" wx:if="{{detailData.description}}">
        <view class="popup-label-row">
          <text class="popup-label">描述</text>
        </view>
        <text class="popup-body-text popup-body-serif">{{detailData.description}}</text>
      </view>

      <view class="popup-section" wx:if="{{detailData.howItFeels}}">
        <view class="popup-label-row">
          <text class="popup-label">感受</text>
        </view>
        <text class="popup-body-text popup-body-serif">{{detailData.howItFeels}}</text>
      </view>

      <view class="popup-section">
        <view class="popup-label-row">
          <text class="popup-label">当前部位</text>
        </view>
        <view class="chip-wrap">
          <view class="chip chip-small chip-sage-selected">{{detailData.bodyPart}}</view>
        </view>
      </view>

      <view class="popup-section" wx:if="{{detailData.commonLocations.length > 0}}">
        <view class="popup-label-row">
          <text class="popup-label">常见位置</text>
        </view>
        <view class="chip-wrap">
          <view class="chip chip-small chip-sage" wx:for="{{detailData.commonLocations}}" wx:key="*this">{{item}}</view>
        </view>
      </view>

      <view class="popup-section" wx:if="{{detailData.relatedEmotions.length > 0}}">
        <view class="popup-label-row">
          <text class="popup-label">相关情绪</text>
        </view>
        <view class="chip-wrap">
          <view class="chip chip-small" wx:for="{{detailData.relatedEmotions}}" wx:key="*this">{{item}}</view>
        </view>
      </view>

      <view class="popup-section" wx:if="{{detailData.signalMeaning}}">
        <view class="popup-label-row">
          <text class="popup-label">信号含义</text>
        </view>
        <text class="popup-body-text popup-body-serif">{{detailData.signalMeaning}}</text>
      </view>

      <view class="popup-section" wx:if="{{detailData.selfCare}}">
        <view class="popup-label-row">
          <text class="popup-label">自我关怀</text>
        </view>
        <text class="popup-body-text popup-body-serif">{{detailData.selfCare}}</text>
      </view>

      <view class="popup-section" wx:if="{{detailData.differsList.length > 0}}">
        <view class="popup-label-row">
          <text class="popup-label">与相近感受的区别</text>
        </view>
        <view class="popup-differs" wx:for="{{detailData.differsList}}" wx:key="key">
          <text class="popup-differs-key">vs {{item.key}}</text>
          <text class="popup-differs-value popup-body-serif">{{item.value}}</text>
        </view>
      </view>

      <view class="popup-section" wx:if="{{detailData.intensitySpectrum}}">
        <view class="popup-label-row">
          <text class="popup-label">强度谱</text>
        </view>
        <text class="popup-body-text popup-body-serif">{{detailData.intensitySpectrum}}</text>
      </view>

      <view class="popup-section-divider" wx:if="{{detailData.relatedParts.length > 0 || detailData.siblings.length > 0}}"></view>

      <view class="popup-section" wx:if="{{detailData.relatedParts.length > 0}}">
        <view class="popup-label-row">
          <text class="popup-label">这种感觉也会出现在</text>
        </view>
        <view class="chip-wrap">
          <view class="chip chip-small chip-sage" wx:for="{{detailData.relatedParts}}" wx:key="*this">{{item}}</view>
        </view>
      </view>

      <view class="popup-section" wx:if="{{detailData.siblings.length > 0}}">
        <view class="popup-label-row">
          <text class="popup-label">「{{detailData.bodyPart}}」的其他感觉</text>
        </view>
        <view class="chip-wrap">
          <view class="chip chip-small chip-sage" wx:for="{{detailData.siblings}}" wx:key="*this">{{item}}</view>
        </view>
      </view>
    </view>

    <!-- Body Part Detail -->
    <view wx:if="{{detailType === 'bodyPart'}}" class="popup-content">
      <view class="hero-header">
        <text class="hero-name">{{detailData.name}}</text>
        <text class="hero-name-en text-muted">身体部位</text>
      </view>

      <view class="popup-section" wx:if="{{detailData.description}}">
        <view class="popup-label-row">
          <text class="popup-label">描述</text>
        </view>
        <text class="popup-body-text popup-body-serif">{{detailData.description}}</text>
      </view>

      <view class="popup-section" wx:if="{{detailData.howToLocate}}">
        <view class="popup-label-row">
          <text class="popup-label">如何定位</text>
        </view>
        <text class="popup-body-text popup-body-serif">{{detailData.howToLocate}}</text>
      </view>

      <view class="popup-section" wx:if="{{detailData.commonSensations.length > 0}}">
        <view class="popup-label-row">
          <text class="popup-label">常见感觉</text>
        </view>
        <view class="chip-wrap">
          <view class="chip chip-small chip-sage" wx:for="{{detailData.commonSensations}}" wx:key="*this">{{item}}</view>
        </view>
      </view>

      <view class="popup-section">
        <view class="popup-label-row">
          <text class="popup-label">可能出现的感觉（{{detailData.sensations.length}} 种）</text>
        </view>
        <view class="chip-wrap">
          <view class="chip chip-small chip-sage" wx:for="{{detailData.sensations}}" wx:key="*this">{{item}}</view>
        </view>
      </view>

      <view class="popup-section" wx:if="{{detailData.emotionalConnection}}">
        <view class="popup-label-row">
          <text class="popup-label">情绪联系</text>
        </view>
        <text class="popup-body-text popup-body-serif">{{detailData.emotionalConnection}}</text>
      </view>

      <view class="popup-section" wx:if="{{detailData.awarenessGuide}}">
        <view class="popup-label-row">
          <text class="popup-label">觉察引导</text>
        </view>
        <text class="popup-body-text popup-body-serif">{{detailData.awarenessGuide}}</text>
      </view>

      <view class="popup-section" wx:if="{{detailData.relatedEmotions.length > 0}}">
        <view class="popup-label-row">
          <text class="popup-label">常见相关情绪</text>
        </view>
        <view class="chip-wrap">
          <view class="chip chip-small" wx:for="{{detailData.relatedEmotions}}" wx:key="name">
            {{item.emoji}} {{item.name}}
          </view>
        </view>
      </view>

      <view class="popup-section" wx:if="{{detailData.culturalNote}}">
        <view class="popup-label-row">
          <text class="popup-label">文化注释</text>
        </view>
        <view class="popup-quote">
          <text class="popup-body-text popup-body-serif">{{detailData.culturalNote}}</text>
        </view>
      </view>
    </view>
  </view>
</view>
