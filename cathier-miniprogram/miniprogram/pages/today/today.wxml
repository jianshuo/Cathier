<view class="container today-page">
  <!-- Greeting -->
  <view class="greeting-area">
    <text class="greeting-text">{{greeting}}</text>
    <text class="greeting-sub" wx:if="{{todayCheckInCount === 0}}">此刻，你想觉察什么？</text>
    <text class="greeting-sub" wx:else>今日已觉察 {{todayCheckInCount}} 次</text>
  </view>

  <!-- Hero CTA Button -->
  <view class="cta-hero" bindtap="onStartCheckIn" hover-class="cta-hero-active">
    <view class="cta-icon-circle">
      <text class="cta-icon">❤️</text>
    </view>
    <text class="cta-title">开始觉察</text>
    <text class="cta-subtitle">从身体感受开始，探索内在情绪</text>
  </view>

  <!-- Today's Check-ins -->
  <view class="today-section" wx:if="{{todayCheckIns.length > 0}}">
    <text class="section-title">今日记录</text>

    <view class="checkin-card" wx:for="{{todayCheckIns}}" wx:key="_id" bindtap="onCheckInTap" data-id="{{item._id}}" hover-class="checkin-card-active">
      <!-- Top row: time + intensity -->
      <view class="checkin-top-row">
        <text class="checkin-time">{{item.time}}</text>
        <view class="intensity-badge" wx:if="{{item.intensity > 0}}" style="background-color: {{item.intensityColor}}20;">
          <text class="intensity-number" style="color: {{item.intensityColor}};">{{item.intensity}}</text>
          <text class="intensity-label" style="color: {{item.intensityColor}};">{{item.intensityLabel}}</text>
        </view>
      </view>

      <!-- Body parts + sensations (grouped) -->
      <view wx:if="{{item.bodyGroups.length > 0}}" class="checkin-body-groups">
        <view class="body-group-row" wx:for="{{item.bodyGroups}}" wx:for-item="bg" wx:key="part">
          <text class="body-part-name">{{bg.part}}</text>
          <text class="body-sensations-text" wx:if="{{bg.sensationsText}}">{{bg.sensationsText}}</text>
        </view>
      </view>

      <!-- Emotion chips (per-category color) -->
      <view class="checkin-emotions" wx:if="{{item.emotions.length > 0}}">
        <view class="emotion-tag" wx:for="{{item.emotions}}" wx:for-item="em" wx:key="label" style="background-color: {{em.categoryColor}}20; color: {{em.categoryColor}};">
          <text>{{em.emoji}} {{em.label}}</text>
        </view>
      </view>

      <!-- Trigger event -->
      <view wx:if="{{item.triggerEvent}}" class="checkin-trigger">
        <text class="trigger-label">触发：</text>
        <text class="trigger-text">{{item.triggerEvent}}</text>
      </view>

      <!-- AI feedback preview -->
      <view wx:if="{{item.feedbackPreview}}" class="checkin-feedback">
        <text class="feedback-icon">✨</text>
        <text class="feedback-text">{{item.feedbackPreview}}</text>
      </view>
    </view>
  </view>

  <!-- 吃一堑长一智 Entry -->
  <view class="lesson-entry" bindtap="onOpenLessonChat" hover-class="lesson-entry-active">
    <view class="lesson-entry-left">
      <text class="lesson-entry-icon">🌱</text>
      <view class="lesson-entry-text">
        <text class="lesson-entry-title">吃一堑，长一智</text>
        <text class="lesson-entry-sub">从挫折或遗憾中提炼智慧</text>
      </view>
    </view>
    <text class="lesson-entry-arrow">→</text>
  </view>

  <!-- Daily Journal -->
  <view class="journal-section">
    <text class="section-title">今日收获</text>

    <!-- Existing journal card -->
    <view class="journal-card" wx:if="{{todayJournal}}" bindtap="onWriteJournal" hover-class="journal-card-active">
      <view class="journal-card-top">
        <text class="journal-mood-emoji">{{todayJournal.moodEmoji}}</text>
        <text class="journal-mood-label">{{todayJournal.moodLabel}}</text>
      </view>
      <text class="journal-gains-preview">{{todayJournal.gainsPreview}}</text>
      <text class="journal-edit-hint text-muted">点击编辑</text>
    </view>

    <!-- No journal yet — CTA button -->
    <view class="journal-cta" wx:else bindtap="onWriteJournal" hover-class="journal-cta-active">
      <text class="journal-cta-icon">📝</text>
      <text class="journal-cta-text">写下今日收获</text>
    </view>
  </view>

  <!-- Stats -->
  <view class="stats-card" wx:if="{{totalCheckInCount > 0}}">
    <view class="stats-row">
      <text class="text-muted">累计觉察</text>
      <text class="stats-number">{{totalCheckInCount}}</text>
      <text class="text-muted">次</text>
    </view>
  </view>

  <!-- Settings Link -->
  <view class="settings-link" bindtap="onOpenSettings">
    <text class="text-muted">设置</text>
  </view>

  <view class="disclaimer">本小程序不提供医疗建议，AI反馈仅供参考</view>
</view>
