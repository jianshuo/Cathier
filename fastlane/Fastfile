# This file contains the fastlane.tools configuration
# You can find the documentation at https://docs.fastlane.tools

# Uncomment the line if you want fastlane to automatically update itself
# update_fastlane
default_platform(:ios)

platform :ios do

  # Shared helper: returns the next build number by querying ASC for the
  # latest build already uploaded (covers both TestFlight and App Store),
  # then incrementing by 1. api_key must already be set up before calling.
  def next_build_number(api_key:)
    latest = latest_testflight_build_number(
      api_key:    api_key,
      app_identifier: "com.wangjianshuo.cathier.Cathier",
      initial_build_number: 0
    )
    latest + 1
  end

  # Reject any existing App Store version that is pending (but not yet In Review).
  # If a version IS In Review, we cannot reject it — raise an error instead of
  # letting upload_to_app_store fail with a cryptic message.
  def reject_pending_version_if_needed(api_key:)
    require "spaceship"

    Spaceship::ConnectAPI.token = Spaceship::ConnectAPI::Token.new(
      key_id:     api_key[:key_id],
      issuer_id:  api_key[:issuer_id],
      key:        Base64.decode64(api_key[:key])
    )

    app = Spaceship::ConnectAPI::App.find("com.wangjianshuo.cathier.Cathier")
    UI.user_error!("App not found on App Store Connect") unless app

    # Fetch all iOS edit versions (non-live)
    versions = app.get_app_store_versions(
      filter: { platform: "IOS" },
      includes: "appVersionState"
    )

    # State constants from the Connect API
    in_review_state   = "IN_REVIEW"
    rejectable_states = %w[
      WAITING_FOR_REVIEW
      PENDING_DEVELOPER_RELEASE
      DEVELOPER_REJECTED
      REJECTED
      PREPARE_FOR_SUBMISSION
      METADATA_REJECTED
    ]

    versions.each do |v|
      state = v.app_version_state
      next if state.nil? || state == "READY_FOR_SALE" || state == "PROCESSING_FOR_DISTRIBUTION"

      if state == in_review_state
        UI.user_error!(
          "Version #{v.version_string} is currently IN_REVIEW — cannot reject it. " \
          "Wait for the review to finish before submitting a new build."
        )
      elsif rejectable_states.include?(state)
        UI.important("Rejecting version #{v.version_string} (state: #{state}) to make room for the new submission.")
        v.reject!
        UI.success("Version #{v.version_string} rejected.")
      end
    end
  end

  # Shared signing + build helper to avoid duplication between lanes.
  def sign_and_build(api_key:)
    match(
      type: "appstore",
      readonly: true,
      git_basic_authorization: Base64.strict_encode64(ENV["MATCH_GIT_BASIC_AUTH"]),
      api_key: api_key
    )

    build_num = next_build_number(api_key: api_key)
    increment_build_number(build_number: build_num)
    UI.message("Build number set to #{build_num}")

    build_app(
      scheme: "Cathier",
      export_method: "app-store",
      xcargs: "CODE_SIGN_STYLE=Manual CODE_SIGN_IDENTITY='Apple Distribution' PROVISIONING_PROFILE_SPECIFIER='match AppStore com.wangjianshuo.cathier.Cathier'",
      export_options: {
        provisioningProfiles: {
          "com.wangjianshuo.cathier.Cathier" => "match AppStore com.wangjianshuo.cathier.Cathier"
        }
      }
    )

    build_num
  end

  desc "Build and upload to TestFlight"
  lane :beta do
    setup_ci

    api_key = app_store_connect_api_key(
      key_id:                ENV["ASC_API_KEY_ID"],
      issuer_id:             ENV["ASC_API_ISSUER_ID"],
      key_content:           ENV["ASC_API_KEY_CONTENT"],
      is_key_content_base64: true,
      duration:              1200,
      in_house:              false
    )

    build_num = sign_and_build(api_key: api_key)

    upload_to_testflight(
      api_key:                           api_key,
      skip_waiting_for_build_processing: false,
      distribute_external:               false,
      notify_external_testers:           false,
      changelog:                         "Build #{build_num} — auto-deployed from main"
    )
  end

  desc "Build, upload to TestFlight, and submit for App Store review"
  lane :release do
    setup_ci

    api_key = app_store_connect_api_key(
      key_id:                ENV["ASC_API_KEY_ID"],
      issuer_id:             ENV["ASC_API_ISSUER_ID"],
      key_content:           ENV["ASC_API_KEY_CONTENT"],
      is_key_content_base64: true,
      duration:              1200,
      in_house:              false
    )

    sign_and_build(api_key: api_key)

    reject_pending_version_if_needed(api_key: api_key)

    upload_to_app_store(
      api_key:                    api_key,
      skip_metadata:              true,
      skip_screenshots:           true,
      submit_for_review:          true,
      automatic_release:          false,
      run_precheck_before_submit: false,
      submission_information: {
        add_id_info_uses_idfa:             false,
        export_compliance_uses_encryption: false,
      }
    )
  end

end
