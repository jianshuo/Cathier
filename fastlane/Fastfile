# This file contains the fastlane.tools configuration
# You can find the documentation at https://docs.fastlane.tools

# Uncomment the line if you want fastlane to automatically update itself
# update_fastlane
default_platform(:ios)

platform :ios do

  # Shared helper: returns the next build number by querying ASC for the
  # latest build already uploaded (covers both TestFlight and App Store),
  # then incrementing by 1. api_key must already be set up before calling.
  def next_build_number(api_key:)
    latest = latest_testflight_build_number(
      api_key:    api_key,
      app_identifier: "com.wangjianshuo.cathier.Cathier",
      initial_build_number: 0
    )
    latest + 1
  end

  # Guard against submitting while a version is IN_REVIEW — deliver's own
  # reject_if_possible cannot handle that state and would produce a cryptic error.
  # All other pending states (WAITING_FOR_REVIEW, DEVELOPER_REJECTED, etc.) are
  # handled by deliver's built-in reject_if_possible: true.
  def guard_not_in_review
    require "spaceship"

    # Spaceship::ConnectAPI.token is already set by app_store_connect_api_key.
    app = Spaceship::ConnectAPI::App.find("com.wangjianshuo.cathier.Cathier")
    UI.user_error!("App not found on App Store Connect") unless app

    versions = app.get_app_store_versions(filter: { platform: "IOS" })
    versions.each do |v|
      if v.app_version_state == "IN_REVIEW"
        UI.user_error!(
          "Version #{v.version_string} is currently IN_REVIEW — cannot submit a new build. " \
          "Wait for the review to finish first."
        )
      end
    end
  end

  # Shared signing + build helper to avoid duplication between lanes.
  def sign_and_build(api_key:)
    match(
      type: "appstore",
      readonly: true,
      git_basic_authorization: Base64.strict_encode64(ENV["MATCH_GIT_BASIC_AUTH"]),
      api_key: api_key
    )

    build_num = next_build_number(api_key: api_key)
    increment_build_number(build_number: build_num)
    UI.message("Build number set to #{build_num}")

    build_app(
      scheme: "Cathier",
      export_method: "app-store",
      xcargs: "CODE_SIGN_STYLE=Manual CODE_SIGN_IDENTITY='Apple Distribution' PROVISIONING_PROFILE_SPECIFIER='match AppStore com.wangjianshuo.cathier.Cathier'",
      export_options: {
        provisioningProfiles: {
          "com.wangjianshuo.cathier.Cathier" => "match AppStore com.wangjianshuo.cathier.Cathier"
        }
      }
    )

    build_num
  end

  desc "Build and upload to TestFlight"
  lane :beta do
    setup_ci

    api_key = app_store_connect_api_key(
      key_id:                ENV["ASC_API_KEY_ID"],
      issuer_id:             ENV["ASC_API_ISSUER_ID"],
      key_content:           ENV["ASC_API_KEY_CONTENT"],
      is_key_content_base64: true,
      duration:              1200,
      in_house:              false
    )

    build_num = sign_and_build(api_key: api_key)

    # Build "What to Test" from recent commits so testers know what changed.
    # Uses the last TestFlight tag as anchor; falls back to last 10 commits.
    last_tag = `git describe --tags --abbrev=0 2>/dev/null`.strip
    if last_tag.empty?
      commits = `git log -10 --pretty=format:"• %s"`.strip
    else
      commits = `git log #{last_tag}..HEAD --pretty=format:"• %s"`.strip
    end
    commits = "• No notable changes" if commits.empty?

    changelog = "Build #{build_num}\n\n" \
                "What changed:\n#{commits}\n\n" \
                "Please test the above and report any issues. 🙏"

    upload_to_testflight(
      api_key:                           api_key,
      skip_waiting_for_build_processing: false,
      distribute_external:               false,
      notify_external_testers:           false,
      changelog:                         changelog
    )

    # Tag this build so the next run knows where to start the commit log.
    sh("git tag testflight/#{build_num} || true")
  end

  desc "Build, upload to TestFlight, and submit for App Store review"
  lane :release do
    setup_ci

    api_key = app_store_connect_api_key(
      key_id:                ENV["ASC_API_KEY_ID"],
      issuer_id:             ENV["ASC_API_ISSUER_ID"],
      key_content:           ENV["ASC_API_KEY_CONTENT"],
      is_key_content_base64: true,
      duration:              1200,
      in_house:              false
    )

    sign_and_build(api_key: api_key)

    guard_not_in_review

    upload_to_app_store(
      api_key:                    api_key,
      skip_metadata:              true,
      skip_screenshots:           true,
      submit_for_review:          true,
      automatic_release:          false,
      reject_if_possible:         true,
      run_precheck_before_submit: false,
      submission_information: {
        add_id_info_uses_idfa:             false,
        export_compliance_uses_encryption: false,
      }
    )
  end

end
