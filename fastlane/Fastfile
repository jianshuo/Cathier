# This file contains the fastlane.tools configuration
# You can find the documentation at https://docs.fastlane.tools

require "set"

# Uncomment the line if you want fastlane to automatically update itself
# update_fastlane
default_platform(:ios)

platform :ios do

  # Shared helper: returns the next build number by querying ASC for the
  # latest build already uploaded (covers both TestFlight and App Store),
  # then incrementing by 1. api_key must already be set up before calling.
  def next_build_number(api_key:)
    latest = latest_testflight_build_number(
      api_key:    api_key,
      app_identifier: "com.wangjianshuo.cathier.Cathier",
      initial_build_number: 0
    )
    latest + 1
  end

  # Guard against submitting while a version is IN_REVIEW — deliver's own
  # reject_if_possible cannot handle that state and would produce a cryptic error.
  # All other pending states (WAITING_FOR_REVIEW, DEVELOPER_REJECTED, etc.) are
  # handled by deliver's built-in reject_if_possible: true.
  def guard_not_in_review
    require "spaceship"

    # Spaceship::ConnectAPI.token is already set by app_store_connect_api_key.
    app = Spaceship::ConnectAPI::App.find("com.wangjianshuo.cathier.Cathier")
    UI.user_error!("App not found on App Store Connect") unless app

    versions = app.get_app_store_versions(filter: { platform: "IOS" })
    versions.each do |v|
      if v.app_version_state == "IN_REVIEW"
        UI.user_error!(
          "Version #{v.version_string} is currently IN_REVIEW — cannot submit a new build. " \
          "Wait for the review to finish first."
        )
      end
    end
  end

  # Push localized "What's New" onto the current edit-state App Store Version.
  # Why this exists: upload_to_app_store with skip_metadata:true silently
  # ignores the release_notes parameter — release notes are part of "metadata"
  # in deliver's view. ASC then rejects submit_for_review because whatsNew is
  # empty on the primary locales. This helper sets whatsNew directly via the
  # App Store Connect API between binary upload and submit_for_review.
  #
  # notes: hash of locale → text (e.g. { "en-US" => "...", "zh-Hans" => "..." })
  def push_release_notes_via_spaceship(notes:)
    require "spaceship"
    app = Spaceship::ConnectAPI::App.find("com.wangjianshuo.cathier.Cathier")
    UI.user_error!("App not found on App Store Connect") unless app

    version = app.get_edit_app_store_version(platform: "IOS")
    UI.user_error!("No edit-state App Store Version found — was the build associated?") unless version

    localizations = version.get_app_store_version_localizations
    if localizations.nil? || localizations.empty?
      UI.user_error!("App Store Version #{version.version_string} has no localizations")
    end

    localizations.each do |loc|
      locale = loc.locale
      text = notes[locale] || notes[locale.split("-").first] || notes["default"]
      next if text.nil? || text.empty?
      loc.update(attributes: { whats_new: text })
      UI.success("whatsNew set for #{locale} (#{text.length} chars)")
    end
  end

  # Upload the freshly-built binary, populate localized whatsNew via Spaceship,
  # then submit the version for App Store review. Three steps because
  # skip_metadata:true makes deliver drop release_notes on the floor — see
  # push_release_notes_via_spaceship for the full explanation.
  # app_version must be passed explicitly: deliver otherwise resolves it from
  # the IPA / project and can land on the currently-live version (2.0), then
  # tries to patch the edit version's versionString to that already-used value
  # and ASC rejects it. Passing the freshly-bumped version keeps deliver's
  # ensure_version! aligned with the edit version bump_marketing_version made.
  def upload_and_submit_for_review(api_key:, app_version:)
    # 1. Upload binary and associate with the edit-state App Store Version.
    #    submit_for_review:false here — we'll submit after whatsNew is set.
    upload_to_app_store(
      api_key:                    api_key,
      app_version:                app_version,
      skip_metadata:              true,
      skip_screenshots:           true,
      submit_for_review:          false,
      run_precheck_before_submit: false,
    )

    # 2. Push localized whatsNew (required by ASC for submit_for_review).
    push_release_notes_via_spaceship(notes: build_release_notes)

    # 3. Submit. Binary already up; metadata now populated.
    upload_to_app_store(
      api_key:                    api_key,
      app_version:                app_version,
      skip_metadata:              true,
      skip_screenshots:           true,
      skip_binary_upload:         true,
      submit_for_review:          true,
      automatic_release:          true,
      reject_if_possible:         true,
      run_precheck_before_submit: false,
      submission_information: {
        add_id_info_uses_idfa:             false,
        export_compliance_uses_encryption: false,
      },
    )
  end

  # Shared signing + build helper. Caller provides the build number so the
  # lane can also use it (e.g. to decide whether to auto-release).
  def sign_and_build(api_key:, build_num:)
    match(
      type: "appstore",
      readonly: true,
      git_basic_authorization: Base64.strict_encode64(ENV["MATCH_GIT_BASIC_AUTH"]),
      api_key: api_key
    )

    increment_build_number(build_number: build_num)
    UI.message("Build number set to #{build_num}")

    build_app(
      scheme: "Cathier",
      export_method: "app-store",
      xcargs: "CODE_SIGN_STYLE=Manual CODE_SIGN_IDENTITY='Apple Distribution' PROVISIONING_PROFILE_SPECIFIER='match AppStore com.wangjianshuo.cathier.Cathier'",
      export_options: {
        provisioningProfiles: {
          "com.wangjianshuo.cathier.Cathier" => "match AppStore com.wangjianshuo.cathier.Cathier"
        }
      }
    )
  end

  # Build localized "What's New" release notes for App Store submission.
  # ASC requires a value for the primary locales when submit_for_review: true.
  # Uses commits since the last release tag; falls back to a generic message.
  def build_release_notes
    last_release_tag = `git tag --list 'release/*' --sort=-version:refname 2>/dev/null | head -1`.strip
    if last_release_tag.empty?
      commits = `git log -10 --pretty=format:"- %s"`.strip
    else
      commits = `git log #{last_release_tag}..HEAD --pretty=format:"- %s"`.strip
    end
    en = commits.empty? ? "Bug fixes and performance improvements." : "What's new:\n#{commits}"
    zh = commits.empty? ? "修复 bug 和性能改进。"             : "更新内容：\n#{commits}"
    ja = commits.empty? ? "バグ修正と性能改善。"               : "更新内容：\n#{commits}"

    {
      "default"      => en,
      "en-US"        => en,
      "zh-Hans"      => zh,
      "ja"           => ja,
    }
  end

  # Write MARKETING_VERSION into the Cathier app target's build settings.
  # The project has GENERATE_INFOPLIST_FILE = YES, so the build derives
  # CFBundleShortVersionString from this build setting — editing Info.plist
  # with agvtool (what increment_version_number does) is silently ignored,
  # which is why earlier bumps never reached the actual binary.
  def set_marketing_version(version)
    require "xcodeproj"
    # fastlane runs lane code with CWD = the fastlane/ dir, so a bare relative
    # path resolves to fastlane/Cathier.xcodeproj. Anchor to the repo root.
    project_path = File.expand_path("../Cathier.xcodeproj", __dir__)
    project = Xcodeproj::Project.open(project_path)
    updated = false
    project.targets.each do |target|
      next unless target.name == "Cathier"
      target.build_configurations.each do |config|
        config.build_settings["MARKETING_VERSION"] = version
        updated = true
      end
    end
    project.save
    UI.user_error!("Target 'Cathier' not found — MARKETING_VERSION not set") unless updated
    UI.message("Set MARKETING_VERSION = #{version} for target Cathier")
  end

  # Bump marketing version decimal-style: 1.9 → 2.0, 2.9 → 3.0.
  # Minor cycles 0..9, then major increments and minor resets.
  #
  # Apple's "version already used" rule covers more than just the active App
  # Store Versions and TestFlight trains list endpoints expose — released
  # builds with archived trains, deleted versions, and other ghosts remain
  # blocked by ASC even though no API call lists them. So instead of trying
  # to enumerate "used" versions, this helper probes by actually creating
  # each candidate via the App Store Versions endpoint and bumps on rejection.
  # The first candidate ASC accepts is set as the local marketing version and
  # remains as an edit-state App Store Version for upload_to_app_store to
  # associate the freshly-built binary with.
  #
  # Returns the new version string.
  def bump_marketing_version(api_key: nil)
    current = get_version_number(xcodeproj: "Cathier.xcodeproj", target: "Cathier")
    parts = current.split(".")
    major = parts[0].to_i
    minor = (parts[1] || "0").to_i

    if api_key.nil?
      # Fallback: no ASC available, blind +1.
      minor += 1
      if minor > 9
        major += 1
        minor = 0
      end
      candidate = "#{major}.#{minor}"
      set_marketing_version(candidate)
      UI.success("Marketing version bumped (no ASC dedup): #{current} → #{candidate}")
      return candidate
    end

    require "spaceship"
    app = Spaceship::ConnectAPI::App.find("com.wangjianshuo.cathier.Cathier")
    UI.user_error!("App not found on App Store Connect") unless app

    # ASC allows only one edit-state version per platform. If a prior run
    # already prepared one (and once a build is uploaded it can't be deleted),
    # that version IS the next release — reuse it instead of trying to create
    # another, which would fail with "cannot create a new version in the
    # current state".
    existing = app.get_edit_app_store_version(platform: "IOS")
    if existing
      UI.success("Reusing existing edit App Store Version #{existing.version_string} (was #{current})")
      set_marketing_version(existing.version_string)
      return existing.version_string
    end

    attempts = 0
    loop do
      attempts += 1
      UI.user_error!("Could not find an available marketing version after 20 attempts") if attempts > 20

      minor += 1
      if minor > 9
        major += 1
        minor = 0
      end
      candidate = "#{major}.#{minor}"

      begin
        Spaceship::ConnectAPI.post_app_store_version(
          app_id: app.id,
          attributes: { platform: "IOS", versionString: candidate }
        )
        UI.success("Created App Store version #{candidate} (was #{current})")
        set_marketing_version(candidate)
        return candidate
      rescue Spaceship::UnexpectedResponse => e
        if e.message.include?("previously used") || e.message.include?("already been used")
          UI.message("ASC rejects #{candidate} as previously used — trying next.")
          next
        end
        raise
      end
    end
  end

  # Commit the bumped version back to main with a custom message.
  # Uses the FEEDBACK_PAT-authenticated remote that actions/checkout set up.
  # [skip ci] in the message prevents the push from re-triggering Build & Deploy.
  def commit_and_push_version_bump(message:)
    # fastlane runs lane code with CWD = the fastlane/ dir, so a bare
    # `git add Cathier.xcodeproj/...` pathspec doesn't resolve. Anchor every
    # git call to the repo root with `git -C`.
    repo = File.expand_path("..", __dir__)
    sh("git -C '#{repo}' config user.email 'github-actions[bot]@users.noreply.github.com'")
    sh("git -C '#{repo}' config user.name 'github-actions[bot]'")
    # Only commit project file. Info.plist has injected secrets at this
    # point (Gateway key, GitHub PAT) and must NOT be committed.
    sh("git -C '#{repo}' add Cathier.xcodeproj/project.pbxproj")

    # If pbxproj wasn't actually modified, the old silent-success path
    # (`commit … || echo 'nothing to commit'`) would push HEAD unchanged,
    # leave main pinned at the just-submitted version, and doom every
    # subsequent non-release upload to "Invalid Pre-Release Train" once
    # Apple closes the released train. Fail loud here instead.
    staged = `git -C '#{repo}' diff --cached --name-only`.strip
    if staged.empty?
      UI.user_error!(
        "Post-release MARKETING_VERSION bump produced NO staged changes. " \
        "set_marketing_version did not modify Cathier.xcodeproj/project.pbxproj — " \
        "aborting before push so main does not stay pinned at the released " \
        "version. Investigate bump_marketing_version / set_marketing_version " \
        "(target name change? Xcodeproj gem error?) before retrying."
      )
    end
    sh("git -C '#{repo}' commit -m '#{message}'")
    sh("git -C '#{repo}' push origin HEAD:main")
  end

  desc "Build and upload to TestFlight."
  desc "If the build number ends in 0 (every 10 builds), also bump the marketing"
  desc "version (1.9 → 2.0) and submit to App Store review."
  lane :beta do
    setup_ci

    api_key = app_store_connect_api_key(
      key_id:                ENV["ASC_API_KEY_ID"],
      issuer_id:             ENV["ASC_API_ISSUER_ID"],
      key_content:           ENV["ASC_API_KEY_CONTENT"],
      is_key_content_base64: true,
      duration:              1200,
      in_house:              false
    )

    build_num = next_build_number(api_key: api_key)
    is_release = (build_num % 10 == 0)

    new_version = nil
    if is_release
      new_version = bump_marketing_version(api_key: api_key)
      UI.message("Build #{build_num} ends in 0 — auto-releasing as version #{new_version}.")
    end

    sign_and_build(api_key: api_key, build_num: build_num)

    if is_release
      # Auto-release path: submit this build to App Store review.
      guard_not_in_review

      upload_and_submit_for_review(api_key: api_key, app_version: new_version)

      # Tag the released commit. The pbxproj at this point still has
      # new_version, so the tag captures that snapshot before the post-release
      # bump rewrites it. main itself never gets a commit at new_version —
      # we jump straight to the next version below.
      sh("git tag release/#{new_version} || true")
      sh("git push origin release/#{new_version} || true")

      # Bump immediately so subsequent TestFlight uploads land on a new
      # pre-release train. Apple closes the train at new_version once the
      # App Store release is approved, after which any TestFlight upload
      # at that version fails with "Invalid Pre-Release Train". By bumping
      # now and pushing back to main, the next non-release CI run picks up
      # the new version and uploads cleanly.
      next_version = bump_marketing_version(api_key: api_key)
      commit_and_push_version_bump(
        message: "chore: bump to #{next_version} after release/#{new_version} [skip ci]"
      )
    else
      # Regular TestFlight upload.
      last_tag = `git describe --tags --abbrev=0 2>/dev/null`.strip
      if last_tag.empty?
        commits = `git log -10 --pretty=format:"• %s"`.strip
      else
        commits = `git log #{last_tag}..HEAD --pretty=format:"• %s"`.strip
      end
      commits = "• No notable changes" if commits.empty?

      changelog = "Build #{build_num}\n\n" \
                  "What changed:\n#{commits}\n\n" \
                  "Please test the above and report any issues. 🙏"

      upload_to_testflight(
        api_key:                           api_key,
        skip_waiting_for_build_processing: false,
        distribute_external:               false,
        notify_external_testers:           false,
        changelog:                         changelog
      )

      # Tag this build so the next run knows where to start the commit log.
      sh("git tag testflight/#{build_num} || true")
    end
  end

  desc "Build, upload to TestFlight, and submit for App Store review"
  lane :release do
    setup_ci

    api_key = app_store_connect_api_key(
      key_id:                ENV["ASC_API_KEY_ID"],
      issuer_id:             ENV["ASC_API_ISSUER_ID"],
      key_content:           ENV["ASC_API_KEY_CONTENT"],
      is_key_content_base64: true,
      duration:              1200,
      in_house:              false
    )

    build_num = next_build_number(api_key: api_key)
    sign_and_build(api_key: api_key, build_num: build_num)

    guard_not_in_review

    app_version = get_version_number(xcodeproj: "Cathier.xcodeproj", target: "Cathier")
    upload_and_submit_for_review(api_key: api_key, app_version: app_version)
  end

end
